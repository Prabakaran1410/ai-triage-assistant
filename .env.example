# Copy to .env and fill in

# Postgres
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triage
DATABASE_URL=postgresql+asyncpg://triage:change-me@db:5432/triage

# Redis
REDIS_URL=redis://redis:6379/0

# LLM provider (choose one; interface picks it up at runtime)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Auth (Phase 0)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Observability
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

ENVIRONMENT=development
