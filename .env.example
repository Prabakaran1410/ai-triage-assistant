# Copy to .env and fill in

# Postgres
# Local docker-compose: postgresql+asyncpg://triage:change-me@db:5432/triage
# Supabase: use the "Connection string" tab (NOT "Build APIs") -> Transaction
# pooler, port 6543, then swap the "postgresql://" prefix for
# "postgresql+asyncpg://". Example shape:
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triage
# Admin URL - migrations only (scripts/migrate.py). Never used by the API.
DATABASE_URL=postgresql+asyncpg://triage:change-me@db:5432/triage

# Runtime URL - unprivileged `triage_app` role, created by
# db/migrations/0002_app_role.sql. Row-level security only actually applies
# through this role; see db/migrations/README.md before setting this.
# Local docker-compose, after setting the role's password by hand:
#   postgresql+asyncpg://triage_app:<password>@db:5432/triage
# Supabase pooler:
#   postgresql+asyncpg://triage_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
APP_DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# LLM provider (choose one; interface picks it up at runtime)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Auth (Phase 0)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Observability
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

ENVIRONMENT=development
